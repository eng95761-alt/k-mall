# Copy to .env for local runs. NEVER commit real values.
DATABASE_URL=sqlite:///./kmall.db
SECRET_KEY=change-me-to-64-random-characters-change-me-to-64-random-characters
HTTPS_ONLY=false
HISTORY_DAYS=14
ALLOW_ROUTER_WRITES=false

ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me-at-least-10-chars

# Access credentials for complex routers
ROUTER_API_USER=
ROUTER_API_PASSWORD=

# Local SOCKS5 from wireproxy (Back to Home tunnel)
SOCKS_PROXY=127.0.0.1:25344

# Router inventory (example values only)
ROUTERS_JSON=[{"id":"r1","name":"Router 1","host":"10.0.0.1","method":"api","port":8728,"um":"v7"},{"id":"r2","name":"Router 2","host":"10.0.0.2","method":"umweb","port":800,"um_interval":300}]

# Base64 of the WireGuard client config (Render only)
BTH_WG_CONFIG_B64=
